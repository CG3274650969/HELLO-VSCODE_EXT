{
  "version": "0.2.0",
  "configurations": [
    {
      // 按 F5 就会跑这个配置：打开一个「Extension Development Host」试验窗口
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: watch"
    }
  ]
}
